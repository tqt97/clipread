{
  "name": "clipread",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\" \"components/**/*.{ts,tsx}\" \"domain/**/*.ts\" \"services/**/*.ts\" \"scripts/**/*.ts\" \"*.{mjs,json}\"",
    "test:worker": "python3 -m unittest discover -s worker -p 'test_*.py'",
    "test:domain": "tsx --test domain/api.test.ts domain/insights.test.ts domain/knowledge.test.ts domain/semantic-search.test.ts domain/workspace.test.ts",
    "test:provider": "tsx --test services/youtube-transcript-provider.test.ts",
    "test:e2e": "playwright test",
    "benchmark:transcript": "tsx scripts/benchmark-transcript.ts",
    "evaluate:search": "tsx scripts/evaluate-search.ts",
    "smoke:public": "tsx scripts/smoke-public-urls.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:domain && npm run test:provider && npm run test:worker && npm run build",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:runtime": "node scripts/prepare-desktop-runtime.mjs",
    "desktop:model": "python3 scripts/ensure-whisper-model.py",
    "desktop:validate": "node scripts/validate-desktop-bundle.mjs",
    "tauri:icons": "tauri icon src-tauri/icons/icon.svg",
    "tauri:build": "tauri build",
    "tauri:dev": "tauri dev"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.26",
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "youtube-transcript-plus": "2.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "engines": {
    "node": ">=22"
  }
}
